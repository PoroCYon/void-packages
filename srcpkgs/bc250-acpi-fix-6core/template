	vmkdir opt/bc250-acpi-fixes/6core

	vinstall "${FILESDIR}/01-dracut-acpi-fixes.conf" 0644 usr/lib/dracut/dracut.conf.d/
	vcopy "${FILESDIR}/*.aml" opt/bc250-acpi-fixes/6core
}
